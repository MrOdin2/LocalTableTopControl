<?xml version="1.0" encoding="UTF-8"?>
<!--
  WiX include file for the jpackage-generated MSI installer.
  Pass the directory containing this file via --resource-dir to jpackage
  when MSI customisation is required.

  NOTE: jpackage's overrides.wxi only supports a limited subset of WiX
  elements (Property, WixVariable, Icon, etc.).  Elements like
  CustomAction and InstallExecuteSequence are NOT supported here and
  will cause candle.exe to fail with exit code 104.
-->
<Include>
  <!-- Add only supported WiX override elements here, for example: -->
  <!-- <WixVariable Id="WixUILicenseRtf" Value="path\to\license.rtf" /> -->
</Include>
